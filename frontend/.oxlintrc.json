{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "import/no-cycle": "error",
    "no-alert": "error",
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-duplicate-imports": "error",
    "react/button-has-type": "error",
    "react/exhaustive-deps": "error",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["error", { "allowConstantExport": true }],
    "typescript/consistent-type-imports": "error"
  },
  "overrides": [
    {
      "files": ["src/components/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "features/",
                "message": "Shared UI components must not import product features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/auth/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../front-page/**",
                  "../main-menu/**",
                  "../game/**",
                  "../../front-page/**",
                  "../../main-menu/**",
                  "../../game/**"
                ],
                "message": "Feature code must not import from another feature folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/front-page/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../auth/**", "../main-menu/**", "../game/**", "../../auth/**", "../../main-menu/**", "../../game/**"],
                "message": "Feature code must not import from another feature folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/main-menu/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../auth/**",
                  "../front-page/**",
                  "../game/**",
                  "../../auth/**",
                  "../../front-page/**",
                  "../../game/**"
                ],
                "message": "Feature code must not import from another feature folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/game/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../auth/**",
                  "../front-page/**",
                  "../main-menu/**",
                  "../../auth/**",
                  "../../front-page/**",
                  "../../main-menu/**"
                ],
                "message": "Feature code must not import from another feature folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/*.tsx"],
      "excludeFiles": ["src/main.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*.css", "./*.css", "../*.css", "**/*.css"],
                "message": "Use Tailwind utilities in TSX; only the app entry should import global CSS."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/main.ts"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["src/tests/setup.ts"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    }
  ]
}
